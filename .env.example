# TruthLens — environment variables
# Copy this file to .env and fill in real values. Do NOT commit .env.

# Google Fact Check Tools API
# https://developers.google.com/fact-check/tools/api
# Without a key, the verifier still works but is heavily rate-limited and
# many calls will return "Google Fact Check rate-limited; try again later."
# Get a free key at https://console.cloud.google.com → APIs & Services →
# Credentials → Create credentials → API key, then enable
# "Fact Check Tools API" for the project.
GOOGLE_FACTCHECK_API_KEY=

# Gemini API — powers the LLM Plausibility verifier (8th RAG source).
# Without this key the verifier degrades to status="unknown" and Rule 7
# (no-evidence cap) takes over instead. With it, claims that the other 7
# verifiers can't fact-check (miracle batteries, instant cures, etc.) get
# a world-knowledge plausibility verdict from gemini-2.5-flash.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (optional) override which Gemini model the plausibility verifier uses
# LLM_PLAUSIBILITY_MODEL=gemini-2.5-flash

# (Reserved for future verifiers — none required today)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# HUGGINGFACE_TOKEN=
